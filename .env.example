APP_NAME="KDK Finance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kdk_finance
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_PATH=/
SESSION_DOMAIN=null

# Duração, criptografia, cookie seguro, SameSite e expiração da sessão ficam em
# Configurações → Segurança (app_settings), junto com HTTPS, cabeçalhos, hosts,
# bloqueio de login e política de senhas. O SMTP também é configurado no painel.

# Verificação SSL das APIs externas. Em produção: true.
FINANCE_VERIFY_SSL=true

# Tempo real (Laravel Reverb). Rode: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP — servidor, porta, criptografia, usuário e senha ficam no painel
# (Configurações → E-mail, senha criptografada em app_settings). Aqui fica
# apenas o transporte padrão: log até o SMTP ser ativado no painel.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@kdkhost.com.br"
MAIL_FROM_NAME="KDK Finance"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
