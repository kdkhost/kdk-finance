<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # A pasta public/ nunca aparece na URL.
    # THE_REQUEST guarda a requisição original do cliente; assim o caminho
    # interno usado para entregar a aplicação nunca provoca um laço. Vale
    # para o Document Root na raiz do projeto ou em public/, inclusive no
    # LiteSpeed, que não aplica as regras do .htaccess pai em subpastas.
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]+)[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+public/?[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Proteções adicionais (hospedagem compartilhada / Apache)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# Nunca serve arquivos ocultos (.env, .git, .htaccess como download).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
